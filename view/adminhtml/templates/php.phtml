<script>
(function () {
    'use strict';
    const root = document.getElementById('mdoq-php-diagnostics');
    const tabs = Array.from(root.querySelectorAll('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll('[role="tabpanel"]'));
    const opcacheContent = document.getElementById('mdoq-opcache-content');
    const fpmContent = document.getElementById('mdoq-fpm-content');
    let opcacheLoaded = false;
    let opcacheLoading = false;
    let fpmLoaded = false;
    let fpmLoading = false;

    async function loadOpcache(forceRefresh) {
        if (opcacheLoading || (opcacheLoaded && !forceRefresh)) return;
        opcacheLoading = true;
        if (!opcacheLoaded) opcacheContent.innerHTML = '<div class="message message-notice"><div>Loading OPcache data...</div></div>';
        try {
            const response = await fetch(opcacheContent.dataset.url, {
                cache: 'no-store',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            if (!response.ok) throw new Error('Unable to load OPcache data.');
            opcacheContent.innerHTML = await response.text();
            opcacheLoaded = true;
            updateCachedScriptList('');
        } catch (error) {
            opcacheLoaded = false;
            const message = document.createElement('div');
            message.className = 'message message-error';
            const text = document.createElement('div');
            text.textContent = error.message || 'Unable to load OPcache data.';
            message.appendChild(text);
            opcacheContent.replaceChildren(message);
        } finally {
            opcacheLoading = false;
        }
    }

    async function loadFpmStatus(forceRefresh) {
        if (fpmLoading || (fpmLoaded && !forceRefresh)) return;
        fpmLoading = true;
        if (!fpmLoaded) fpmContent.innerHTML = '<div class="message message-notice"><div>Loading PHP-FPM status...</div></div>';
        try {
            const response = await fetch(fpmContent.dataset.url, {
                cache: 'no-store',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });
            if (!response.ok) throw new Error('Unable to load PHP-FPM status.');
            fpmContent.innerHTML = await response.text();
            fpmLoaded = true;
        } catch (error) {
            fpmLoaded = false;
            const message = document.createElement('div');
            message.className = 'message message-error';
            const text = document.createElement('div');
            text.textContent = error.message || 'Unable to load PHP-FPM status.';
            message.appendChild(text);
            fpmContent.replaceChildren(message);
        } finally {
            fpmLoading = false;
        }
    }

    function updateCachedScriptList(searchTerm) {
        const rows = Array.from(opcacheContent.querySelectorAll('[data-opcache-script-rows] tr'));
        if (!rows.length) {
            const count = opcacheContent.querySelector('[data-opcache-script-count]');
            if (count) count.textContent = 'Showing 0 of 0 matching scripts';
            const empty = opcacheContent.querySelector('[data-opcache-no-matches]');
            if (empty) empty.hidden = false;
            return;
        }
        const limit = Number(rows[0].parentElement.dataset.visibleLimit || 200);
        const query = searchTerm.trim().toLowerCase();
        let matching = 0;
        let visible = 0;
        rows.forEach(function (row) {
            const matches = (row.dataset.path || '').includes(query);
            if (!matches) {
                row.hidden = true;
                return;
            }
            matching += 1;
            row.hidden = visible >= limit;
            if (!row.hidden) visible += 1;
        });
        const count = opcacheContent.querySelector('[data-opcache-script-count]');
        if (count) count.textContent = 'Showing ' + visible.toLocaleString() + ' of ' + matching.toLocaleString() + ' matching scripts';
        const more = opcacheContent.querySelector('[data-opcache-show-more]');
        if (more) more.hidden = visible >= matching;
        const empty = opcacheContent.querySelector('[data-opcache-no-matches]');
        if (empty) empty.hidden = matching > 0;
    }

    function activateTab(tab, moveFocus) {
        tabs.forEach(function (item) {
            const selected = item === tab;
            item.classList.toggle('_active', selected);
            item.setAttribute('aria-selected', selected ? 'true' : 'false');
            item.tabIndex = selected ? 0 : -1;
        });
        panels.forEach(function (panel) {
            panel.hidden = panel.id !== tab.getAttribute('aria-controls');
        });
        if (tab.id === 'mdoq-php-tab-opcache') loadOpcache(false);
        if (tab.id === 'mdoq-php-tab-status') loadFpmStatus(false);
        if (moveFocus) tab.focus();
    }

    root.addEventListener('click', function (event) {
        const fpmRefresh = event.target.closest('[data-fpm-refresh]');
        if (fpmRefresh) {
            loadFpmStatus(true);
            return;
        }
        const refresh = event.target.closest('[data-opcache-refresh]');
        if (refresh) {
            loadOpcache(true);
            return;
        }
        const viewTab = event.target.closest('[data-opcache-view]');
        if (viewTab) {
            const dashboard = viewTab.closest('#mdoq-opcache-dashboard');
            dashboard.querySelectorAll('[data-opcache-view]').forEach(function (item) {
                item.setAttribute('aria-selected', item === viewTab ? 'true' : 'false');
            });
            dashboard.querySelectorAll('[data-opcache-section]').forEach(function (section) {
                section.hidden = section.id !== viewTab.getAttribute('aria-controls');
            });
            return;
        }
        if (event.target.closest('[data-opcache-show-more]')) {
            const rows = opcacheContent.querySelector('[data-opcache-script-rows]');
            rows.dataset.visibleLimit = String(Number(rows.dataset.visibleLimit || 200) + 200);
            const filter = opcacheContent.querySelector('[data-opcache-filter]');
            updateCachedScriptList(filter ? filter.value : '');
        }
    });

    root.addEventListener('input', function (event) {
        if (event.target.matches('[data-opcache-filter]')) {
            const rows = opcacheContent.querySelector('[data-opcache-script-rows]');
            if (rows) rows.dataset.visibleLimit = '200';
            updateCachedScriptList(event.target.value);
        }
    });

    tabs.forEach(function (tab, index) {
        tab.addEventListener('click', function () { activateTab(tab, false); });
        tab.addEventListener('keydown', function (event) {
            let nextIndex = index;
            if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
            else if (event.key === 'ArrowLeft') nextIndex = (index + tabs.length - 1) % tabs.length;
            else if (event.key === 'Home') nextIndex = 0;
            else if (event.key === 'End') nextIndex = tabs.length - 1;
            else return;
            event.preventDefault();
            activateTab(tabs[nextIndex], true);
        });
    });
}());
</script>